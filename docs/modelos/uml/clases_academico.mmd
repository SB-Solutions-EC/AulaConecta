classDiagram
  direction TB
  class Persona {
    +id: UUID
    +cedula: string
    +nombres: string
    +apellidos: string
    +activo: boolean
    +actualizarDatos() void
    +desactivar() void
  }
  class Usuario {
    +id: UUID
    +nombreUsuario: string
    -passwordHash: string
    -claveTemporalHash: string
    +venceClaveTemporal: Date
    +intentosFallidos: int
    +estado: EstadoCuenta
    +generarClaveTemporal() string
    +activarCuenta(claveTemporal, nueva) void
    +iniciarSesion(clave) boolean
    +bloquear() void
    +tieneRol(codigo) boolean
  }
  class Rol {
    +id: UUID
    +codigo: string
    +nombre: string
    +estado: string
    +desactivar() void
  }
  class UsuarioRol {
    +fechaAsignacion: Date
    +estado: string
    +revocar() void
  }
  class Curso {
    +id: UUID
    +nivel: string
    +paralelo: string
  }
  class Materia {
    +id: UUID
    +codigo: string
    +nombre: string
  }
  class Asignacion {
    +id: UUID
    +horarioResumen: string
  }
  class Matricula {
    +id: UUID
    +codigoMatricula: string
    +estado: string
    +retirar() void
  }
  class Representacion {
    +parentesco: string
    +telefonoWhatsapp: string
