# Copia este archivo a infra/.env y cambia las claves. infra/.env nunca se sube al repositorio.
# Son solo para el entorno local: en los ambientes desplegados llegan desde GitHub Environments.
# Si cambias una clave después de crear las bases, recrea el volumen (ver infra/README.md).

# Administrador de PostgreSQL: solo para mantenimiento, ningún servicio lo usa
POSTGRES_PASSWORD=cambiar-admin-local

# Un usuario por servicio
POSTGRES_IDENTIDAD_PASSWORD=cambiar-identidad-local
POSTGRES_ACADEMICO_PASSWORD=cambiar-academico-local
POSTGRES_NOTIFICACIONES_PASSWORD=cambiar-notificaciones-local

# Bus de eventos RabbitMQ
RABBITMQ_USER=aulaconecta
RABBITMQ_PASSWORD=cambiar-rabbitmq-local
