# Copia este archivo como .env y ajusta los valores. El .env nunca se sube al repositorio.
NODE_ENV=development
PORT=3000
# true o false. En producción está apagado si no se indica.
SWAGGER_HABILITADO=true
# ms-identidad y el archivo con el secreto de servicio (nunca el secreto aquí). Ver el README.
IDENTIDAD_URL=http://localhost:18080
AULACONECTA_CLIENTE_ID=ms-academico
# AULACONECTA_CLIENTE_SECRETO_ARCHIVO=/ruta/al/secreto
