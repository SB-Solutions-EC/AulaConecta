// Esquema de db_academico (PostgreSQL). Sigue el modelo de 26 tablas de docs/modelos/bd:
// claves primarias UUID generadas por la aplicación (también sin conexión), columna version
// para la sincronización y referencias a otros servicios solo por UUID, sin llave foránea.
// La URL de conexión está en prisma.config.ts (Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generado/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Año escolar con sus fechas (RF-07).
model AnioLectivo {
  id            String    @id @db.Uuid
  nombre        String    @unique @db.VarChar(20)
  fechaInicio   DateTime  @map("fecha_inicio") @db.Date
  fechaFin      DateTime  @map("fecha_fin") @db.Date
  activo        Boolean   @default(false)
  version       Int       @default(1)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime? @updatedAt @map("actualizado_en")

  periodos Periodo[]
  cursos   Curso[]

  @@map("anio_lectivo")
}

/// Trimestre del año lectivo; al cerrarse se bloquean las notas (RN-18).
model Periodo {
  id            String    @id @db.Uuid
  anioLectivoId String    @map("id_anio_lectivo") @db.Uuid
  numero        Int       @db.SmallInt
  fechaInicio   DateTime  @map("fecha_inicio") @db.Date
  fechaFin      DateTime  @map("fecha_fin") @db.Date
  cerrado       Boolean   @default(false)
  version       Int       @default(1)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime? @updatedAt @map("actualizado_en")

  anioLectivo    AnioLectivo    @relation(fields: [anioLectivoId], references: [id], onDelete: Restrict)
  calificaciones Calificacion[]

  @@unique([anioLectivoId, numero])
  @@map("periodo")
}

/// Datos personales de docentes, estudiantes y representantes. La cuenta vive en ms-identidad
/// y se enlaza 1 a 1 por usuario_id (único).
model Persona {
  id              String      @id @db.Uuid
  usuarioId       String?     @unique @map("usuario_id") @db.Uuid
  tipo            TipoPersona
  cedula          String      @unique @db.VarChar(10)
  nombres         String      @db.VarChar(80)
  apellidos       String      @db.VarChar(80)
  area            String?     @db.VarChar(80)
  // Datos opcionales del diccionario de datos (Taller 2, tabla persona); solo los ve el personal del colegio
  fechaNacimiento DateTime?   @map("fecha_nacimiento") @db.Date
  /// M o F (restricción CHECK en la migración)
  sexo            String?     @db.Char(1)
  /// Contacto general 09XXXXXXXX. El celular para avisos y su autorización viven en ms-notificaciones
  telefono        String?     @db.VarChar(10)
  correo          String?     @unique @db.VarChar(120)
  direccion       String?     @db.VarChar(200)
  activo          Boolean     @default(true)
  version         Int         @default(1)
  creadoEn        DateTime    @default(now()) @map("creado_en")
  actualizadoEn   DateTime?   @updatedAt @map("actualizado_en")

  cursosTutor  Curso[]      @relation("TutorCurso")
  matriculas   Matricula[]
  asignaciones Asignacion[]

  @@index([tipo])
  @@map("persona")
}

enum TipoPersona {
  DOCENTE
  ESTUDIANTE
  REPRESENTANTE
}

/// Curso y paralelo de un año lectivo (RF-06).
model Curso {
  id            String    @id @db.Uuid
  anioLectivoId String    @map("id_anio_lectivo") @db.Uuid
  tutorId       String?   @map("id_tutor") @db.Uuid
  nivel         String    @db.VarChar(40)
  paralelo      String    @db.VarChar(2)
  version       Int       @default(1)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime? @updatedAt @map("actualizado_en")

  anioLectivo  AnioLectivo  @relation(fields: [anioLectivoId], references: [id], onDelete: Restrict)
  tutor        Persona?     @relation("TutorCurso", fields: [tutorId], references: [id], onDelete: Restrict)
  matriculas   Matricula[]
  asignaciones Asignacion[]

  @@unique([anioLectivoId, nivel, paralelo])
  @@map("curso")
}

/// Catálogo de asignaturas (RF-06). El código corto (p. ej. MAT) es único (Taller 2, tabla materia).
model Materia {
  id            String    @id @db.Uuid
  codigo        String    @unique @db.VarChar(10)
  nombre        String    @db.VarChar(80)
  area          String?   @db.VarChar(80)
  version       Int       @default(1)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime? @updatedAt @map("actualizado_en")

  asignaciones Asignacion[]

  @@map("materia")
}

/// Tabla intermedia N a N entre estudiante (persona) y curso (RF-04).
model Matricula {
  id              String          @id @db.Uuid
  estudianteId    String          @map("id_estudiante") @db.Uuid
  cursoId         String          @map("id_curso") @db.Uuid
  /// Código visible de la matrícula, p. ej. AND-2026-0001 (Taller 2, tabla matricula)
  codigoMatricula String          @unique @map("codigo_matricula") @db.VarChar(15)
  fechaMatricula  DateTime        @default(now()) @map("fecha_matricula") @db.Date
  estado          EstadoMatricula @default(ACTIVA)
  version         Int             @default(1)
  creadoEn        DateTime        @default(now()) @map("creado_en")
  actualizadoEn   DateTime?       @updatedAt @map("actualizado_en")

  estudiante     Persona        @relation(fields: [estudianteId], references: [id], onDelete: Restrict)
  curso          Curso          @relation(fields: [cursoId], references: [id], onDelete: Restrict)
  calificaciones Calificacion[]

  @@unique([estudianteId, cursoId])
  @@index([cursoId])
  @@map("matricula")
}

enum EstadoMatricula {
  ACTIVA
  RETIRADA
}

/// Tabla intermedia N a N: qué docente dicta qué materia en qué curso (RF-05). Los endpoints son de T1110-M.
model Asignacion {
  id             String    @id @db.Uuid
  docenteId      String    @map("id_docente") @db.Uuid
  materiaId      String    @map("id_materia") @db.Uuid
  cursoId        String    @map("id_curso") @db.Uuid
  /// Días y horas de clase semanales (RF-37)
  horarioResumen String?   @map("horario_resumen") @db.VarChar(150)
  /// Bloques semanales [{id, dia 1-5, hora h1-h5}] (contrato BloqueHorario, RF-37)
  horarios       Json      @default("[]")
  version        Int       @default(1)
  creadoEn       DateTime  @default(now()) @map("creado_en")
  actualizadoEn  DateTime? @updatedAt @map("actualizado_en")

  docente        Persona        @relation(fields: [docenteId], references: [id], onDelete: Restrict)
  materia        Materia        @relation(fields: [materiaId], references: [id], onDelete: Restrict)
  curso          Curso          @relation(fields: [cursoId], references: [id], onDelete: Restrict)
  calificaciones Calificacion[]

  @@unique([materiaId, cursoId])
  @@index([docenteId])
  @@map("asignacion")
}

/// Resumen trimestral de un estudiante en una materia (RF-17, RF-18). La nota final y el cualitativo
/// los calcula el servidor con packages/calculo; nunca se aceptan del cliente.
model Calificacion {
  id              String    @id @db.Uuid
  matriculaId     String    @map("id_matricula") @db.Uuid
  asignacionId    String    @map("id_asignacion") @db.Uuid
  periodoId       String    @map("id_periodo") @db.Uuid
  /// Aportes de cada bloque, de 0 a 10 con hasta 2 decimales (CHECK en la migración)
  aportesBloque1  Decimal[] @map("aportes_bloque1") @db.Decimal(4, 2)
  aportesBloque2  Decimal[] @map("aportes_bloque2") @db.Decimal(4, 2)
  /// Promedio de los dos bloques (con refuerzo si lo hay), truncado a 2 decimales
  promedioAportes Decimal?  @map("promedio_aportes") @db.Decimal(4, 2)
  refuerzo        Decimal?  @db.Decimal(4, 2)
  notaProyecto    Decimal?  @map("nota_proyecto") @db.Decimal(4, 2)
  notaExamen      Decimal?  @map("nota_examen") @db.Decimal(4, 2)
  notaFinal       Decimal?  @map("nota_final") @db.Decimal(4, 2)
  cualitativo     String?   @db.Char(2)
  /// Cuenta (ms-identidad) del docente que hizo el último cambio
  actualizadoPor  String?   @map("actualizado_por") @db.Uuid
  version         Int       @default(1)
  creadoEn        DateTime  @default(now()) @map("creado_en")
  actualizadoEn   DateTime? @updatedAt @map("actualizado_en")

  matricula  Matricula  @relation(fields: [matriculaId], references: [id], onDelete: Restrict)
  asignacion Asignacion @relation(fields: [asignacionId], references: [id], onDelete: Restrict)
  periodo    Periodo    @relation(fields: [periodoId], references: [id], onDelete: Restrict)

  @@unique([matriculaId, asignacionId, periodoId])
  @@index([asignacionId, periodoId])
  @@map("calificacion")
}
